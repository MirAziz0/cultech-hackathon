# All keys are optional. Without them the app runs in MOCK MODE:
# the architect answers from facts.json + qa.json and speaks with browser TTS or subtitles.

# Live Q&A with the architect (/api/architect) and `npm run narration -- --text`
ANTHROPIC_API_KEY=
# defaults to claude-opus-5-5
ANTHROPIC_MODEL=claude-opus-5-5

# Azerbaijani neural TTS with viseme lip sync (/api/tts) and `npm run narration -- --audio`
# voices: az-AZ-BabekNeural (male), az-AZ-BanuNeural (female)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope
