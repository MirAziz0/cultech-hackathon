# All keys are optional. Without them the app runs in MOCK MODE:
# the architect answers from facts.json + qa.json and speaks with browser TTS or subtitles.

# Live Q&A with the architect (/api/architect) and `npm run narration -- --text`
ANTHROPIC_API_KEY=
# defaults to claude-opus-5-5
ANTHROPIC_MODEL=claude-opus-5-5

# Azerbaijani neural TTS with viseme lip sync (/api/tts) and `npm run narration -- --audio`
# voices: az-AZ-BabekNeural (male), az-AZ-BanuNeural (female)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope

# ElevenLabs TTS (Eleven v3 speaks Azerbaijani); voice id to be chosen
ELEVENLABS_API_KEY=...
# default voice for Azerbaijani: YH1Mz146w2IogsiQAoF0 (a Voice Library voice: needs a paid ElevenLabs plan)
ELEVENLABS_VOICE_ID=...

# Gemini TTS (Azerbaijani + English) for /api/tts and `npm run narration -- --audio`; used when Azure is not set.
# No word timings: lip sync follows the loudness of the audio. Falls back to the keyless Edge voices on errors.
GEMINI_API_KEY=
# defaults: gemini-3.8-flash-tts, voices Algieba (male) / Sulafat (female)
GEMINI_TTS_MODEL=
GEMINI_VOICE_MALE=
GEMINI_VOICE_FEMALE=
